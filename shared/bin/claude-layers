#!/usr/bin/env bash
#
# claude-layers — assemble ~/.claude from layered config directories.
#
# The base layer is this repo's shared/claude. Extra layers (e.g. a work-only
# one that must stay out of this public repo) are listed one directory per line
# in ~/.claude/layers, which is machine-local and never committed. Later layers
# win.
#
# Each layer directory may contain:
#   settings.json  deep-merged into ~/.claude/settings.json: objects merge,
#                  arrays concatenate without duplicates, scalars from the
#                  later layer win
#   CLAUDE.md      @-imported from ~/.claude/CLAUDE.md, in layer order
#   skills/*/      symlinked into ~/.claude/skills/
#
# ~/.claude/settings.json is a generated file, but Claude Code also writes to it
# (/model, /config, permission prompts). A run refuses to overwrite edits made
# since the last build; move them into the right layer, or pass -f to discard.

set -euo pipefail
shopt -s nullglob

force=0
[[ "${1:-}" == "-f" ]] && force=1

claude_dir="$HOME/.claude"
base="$(cd "$(dirname "$(realpath "$0")")/../claude" && pwd)"

layers=("$base")
if [[ -f "$claude_dir/layers" ]]; then
  while read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    line="${line/#\~/$HOME}"
    if [[ ! -d "$line" ]]; then
      echo "claude-layers: layer not found: $line" >&2
      exit 1
    fi
    layers+=("$line")
  done < "$claude_dir/layers"
fi

mkdir -p "$claude_dir/skills"

# ---- settings.json ----

settings_files=()
for layer in "${layers[@]}"; do
  [[ -f "$layer/settings.json" ]] && settings_files+=("$layer/settings.json")
done

merged="$(jq -s '
  def merge($a; $b):
    if ($a | type) == "object" and ($b | type) == "object" then
      reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = merge(.[$k]; $b[$k]))
    elif ($a | type) == "array" and ($b | type) == "array" then
      reduce $b[] as $x ($a; if any(.[]; . == $x) then . else . + [$x] end)
    elif $b == null then $a
    else $b end;
  reduce .[1:][] as $layer (.[0]; merge(.; $layer))
' "${settings_files[@]}")"

target="$claude_dir/settings.json"
snapshot="$claude_dir/.settings.generated.json"

if [[ -L "$target" ]]; then
  rm "$target"
elif [[ -f "$target" && $force -eq 0 ]]; then
  if [[ ! -f "$snapshot" ]] || ! diff -q <(jq -S . "$snapshot") <(jq -S . "$target") > /dev/null; then
    echo "claude-layers: $target was edited since the last build:" >&2
    diff <(jq -S . "$snapshot" 2> /dev/null || echo '{}') <(jq -S . "$target") >&2 || true
    echo "Move these edits into a layer and rerun, or pass -f to discard them." >&2
    exit 1
  fi
fi

printf '%s\n' "$merged" > "$target.tmp"
mv -f "$target.tmp" "$target"
cp -f "$target" "$snapshot"

# ---- CLAUDE.md ----

claude_md="$claude_dir/CLAUDE.md"
[[ -L "$claude_md" ]] && rm "$claude_md"
{
  echo "<!-- Generated by claude-layers. Edit the layer files instead. -->"
  for layer in "${layers[@]}"; do
    [[ -f "$layer/CLAUDE.md" ]] && echo "@$layer/CLAUDE.md"
  done
} > "$claude_md"

# ---- skills ----

# Drop links whose target is gone (skill removed or moved between layers).
for link in "$claude_dir"/skills/*; do
  [[ -L "$link" && ! -e "$link" ]] && rm "$link"
done

for layer in "${layers[@]}"; do
  for skill in "$layer"/skills/*/; do
    skill="${skill%/}"
    ln -nfs "$skill" "$claude_dir/skills/$(basename "$skill")"
  done
done

echo "claude-layers: built from ${layers[*]}"
